<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@/styles/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.passman.desktop.ui.dashboard.DashboardController">

    <!-- Top Bar -->
    <top>
        <VBox styleClass="top-bar">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>

                <Label styleClass="app-title" text="🔐 PassMan" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" styleClass="welcome-label" text="Welcome!" />
                <Button onAction="#handleLogout" styleClass="logout-button" text="Logout" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar">
                <padding>
                    <Insets bottom="10" left="20" right="20" top="10" />
                </padding>

                <TextField fx:id="searchField" prefWidth="300" promptText="🔍 Search passwords..." styleClass="search-field" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addButton" onAction="#handleAddCredential" styleClass="action-button" text="➕ Add" />
                <Button onAction="#handleGeneratePassword" styleClass="action-button" text="🎲 Generate" />
                <Button onAction="#handleBackup" styleClass="action-button" text="💾 Backup" />
            </HBox>
        </VBox>
    </top>

    <!-- Main Content -->
    <center>
        <BorderPane>
            <left>
                <VBox prefWidth="200" spacing="5" styleClass="sidebar">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>

                    <Label styleClass="sidebar-header" text="CATEGORIES" />
                    <Button maxWidth="Infinity" styleClass="sidebar-button" text="🏠 All Passwords" />
                    <Button maxWidth="Infinity" styleClass="sidebar-button" text="⭐ Favorites" />
                    <Button maxWidth="Infinity" styleClass="sidebar-button" text="🔒 Passwords" />
                    <Button maxWidth="Infinity" onAction="#handleNotes" styleClass="sidebar-button" text="📝 Secure Notes" />
                    <Button maxWidth="Infinity" onAction="#handleIdentityCards" styleClass="sidebar-button" text="🆔 Identity Cards" />
                    <!-- Update the File Vaults button -->
                    <Button maxWidth="Infinity" onAction="#handleFileVaults" styleClass="sidebar-button" text="📁 File Vaults" />

                    <Separator />

                    <Label styleClass="sidebar-header" text="FEATURES" />
                    <Button maxWidth="Infinity" styleClass="sidebar-button" text="📊 Analytics" />
                    <Button maxWidth="Infinity" onAction="#handleGraph" styleClass="sidebar-button" text="📈 Graph View" />
                    <Button maxWidth="Infinity" onAction="#handleQuiz" styleClass="sidebar-button" text="🎮 Quiz" />
                    <Button maxWidth="Infinity" onAction="#handleQRShare" styleClass="sidebar-button" text="📱 QR Share" />
                    <Button maxWidth="Infinity" onAction="#handleAdmin" styleClass="sidebar-button" text="⚙👤 Admin" />
                </VBox>
            </left>

            <center>
                <VBox spacing="10">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label styleClass="section-title" text="Your Passwords" />

                    <TableView fx:id="credentialsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="200" text="Title" />
                            <TableColumn prefWidth="150" text="Username" />
                            <TableColumn prefWidth="200" text="URL" />
                            <TableColumn prefWidth="100" text="Age" />
                            <TableColumn prefWidth="100" text="Strength" />
                        </columns>
                    </TableView>
                </VBox>
            </center>
        </BorderPane>
    </center>

</BorderPane>
