<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_card_gradient">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Card Type Emoji -->
            <TextView
                android:id="@+id/tvCardEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Card Name -->
                <TextView
                    android:id="@+id/tvCardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="My Credit Card"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Issuer -->
                <TextView
                    android:id="@+id/tvIssuer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bank Name"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- Favorite Icon -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_favorite_outline"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Card Number (masked) -->
        <TextView
            android:id="@+id/tvCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="**** **** **** 1234"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp" />

        <!-- Bottom Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Cardholder Name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARDHOLDER"
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvCardholderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JOHN DOE"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:textAllCaps="true" />
            </LinearLayout>

            <!-- Expiry -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPIRES"
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/25"
                    android:textSize="12sp"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expiry Warning Badge -->
        <TextView
            android:id="@+id/tvExpiryWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Expiring Soon"
            android:textSize="11sp"
            android:textColor="@android:color/holo_orange_light"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
